[Unit]
Description=Audiothek Downloader Batch Run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Allows overriding the Docker image or mount paths via an environment file if needed
EnvironmentFile=%h/.config/codescape/audiothek-downloader/env
# Pull the docker image before execution
ExecStartPre=/usr/bin/docker pull ${DOCKER_IMAGE}
ExecStart=/usr/bin/docker run --rm \
    --network ${DOCKER_NETWORK} \
    -e TELEMETRY_API_URL=${TELEMETRY_API_URL} \
    -v %h/.local/share/codescape/audiothek-downloader:/data:rw \
    -v ${PODCAST_STORAGE_DIR}:/podcasts:rw \
    ${DOCKER_IMAGE}

[Install]
WantedBy=default.target
